{
	"name": "@ydb-platform/ydb-slo-action",
	"type": "module",
	"scripts": {
		"prebundle": "rm -rf dist",
		"bundle": "bun build init/main.ts init/post.ts report/main.ts --target=node --format=esm --splitting --minify-syntax --sourcemap=none --outdir dist",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"format": "oxfmt '**/*.ts'",
		"format:check": "oxfmt --check '**/*.ts'",
		"lint": "oxlint --max-warnings 0 init report shared tests deploy"
	},
	"dependencies": {
		"@actions/artifact": "^6.2.1",
		"@actions/core": "^3.0.0",
		"@actions/exec": "^3.0.0",
		"@actions/github": "^9.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.3",
		"@types/node": "^24.0.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"packageManager": "bun@1.4.2"
}
